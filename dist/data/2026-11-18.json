u","sāt","jaan","méih","tā",null,"chéng","jung","hāau","gú","móuh","douh","jaan","méih","tā",null,"chéng","jung","lāai","yìhn","chēui","dehk","jaan","méih","tā",null]},{"zh":"【答】：聖！聖！聖！上主，全能的天主。","yale":[null,"daap",null,null,"sing",null,"sing",null,"sing",null,"seuhng","jyú",null,"chyùhn","nàhng","dīk","tīn","jyú",null]},{"zh":"領：請眾以聲洪的鐃鈸讚美他，請眾以響亮的鐃鈸讚美他！一切有氣息的，請讚美上主！亞肋路亞。","yale":["líhng",null,"chéng","jung","yíh","sīng","hùhng","dīk","nàauh","baht","jaan","méih","tā",null,"chéng","jung","yíh","héung","leuhng","dīk","nàauh","baht","jaan","méih","tā",null,"yāt","chai","yáuh","hei","sīk","dīk",null,"chéng","jaan","méih","seuhng","jyú",null,"a","lahk","louh","a",null]},{"zh":"【答】：聖！聖！聖！上主，全能的天主。","yale":[null,"daap",null,null,"sing",null,"sing",null,"sing",null,"seuhng","jyú",null,"chyùhn","nàhng","dīk","tīn","jyú",null]}],"enMissing":["150:1","150:2","150:3","150:4","150:5","150:6"]},{"kind":"alleluia","label":"福音前歡呼","heading":"福音前歡呼","citation":null,"lines":[{"zh":"領：亞肋路亞。","yale":["líhng",null,"a","lahk","louh","a",null]},{"zh":"眾：亞肋路亞。","yale":["jung",null,"a","lahk","louh","a",null]},{"zh":"領：主說：「我揀選了你們，並派你們去結果實，去結常存的果實。」","yale":["líhng",null,"jyú","syut",null,null,"ngóh","gáan","syún","líuh","néih","mùhn",null,"bihng","paai","néih","mùhn","heui","git","gwó","saht",null,"heui","git","sèuhng","chyùhn","dīk","gwó","saht",null,null]},{"zh":"眾：亞肋路亞。","yale":["jung",null,"a","lahk","louh","a",null]}]},{"kind":"gospel","label":"福音","heading":"福音（為什麼不把我的錢存在錢莊裏？）","citation":"路 19:11-28","lines":[{"zh":"主祭：願主與你們同在。","yale":["jyú","jai",null,"yuhn","jyú","yúh","néih","mùhn","tùhng","joih",null]},{"zh":"眾：也與你的心靈同在。","yale":["jung",null,"yáh","yúh","néih","dīk","sām","lìhng","tùhng","joih",null]},{"zh":"恭讀聖路加福音","yale":["gūng","duhk","sing","louh","gā","fūk","yām"]},{"zh":"眾：主，願光榮歸於你。","yale":["jung",null,"jyú",null,"yuhn","gwōng","wìhng","gwāi","yū","néih",null]},{"zh":"當眾人聽耶穌講話的時候，耶穌因為已臨近耶路撒冷，而且他們都以為天主的國快要出現，遂設了一個比喻說：「有一個貴人起身到遠方去，為取得了王位再回來。他將自己的十個僕人叫來，交給他們十個「米納」（銀幣），並囑咐說：你們拿去做生意，直到我回來。他本國的人一向懷恨他，遂在他後面派代表去說：我們不願意這人為王統治我們。這貴人得了王位歸來以後，便傳召那些領了他錢的僕人，想知道每個人做生意賺了多少。第一個前來說：主！你的那個「米納」（銀幣）賺了十個「米納」（銀幣）。主人對他說：好，善僕！你既然在小事上忠信，你要有權掌管十座城。第二個前來說：主！你的那個「米納」（銀幣）賺了五個「米納」（銀幣）。主人也對這人說：你也要掌管五座城。另一個前來說：主！看，你那個「米納」（銀幣），我收存在手巾裏。我一向害怕你，因為你是一個嚴厲的人：你沒有存放的，也要提取；沒有下種的，也要收割。主人向他說：惡僕！我就憑你的口供定你的罪。你不是知道我是個嚴厲的人，沒有存放的，也要提取；沒有下種的，也要收割的嗎？為什麼你不把我的錢存於錢莊？待我回來時，我可以連本帶利取出來。主人便向侍立左右的人說：你們把他那個「米納」（銀幣）奪過來，給那有十個的。他們向他說：主！他已有十個「米納」（銀幣）了。我告訴你們：凡是有的，還要給他；那沒有的，連他所有的，也要從他奪去。至於那些敵對我，不願意我作他們君王的人，你們把他們押到這裏，在我面前殺掉。」","yale":["dōng","jung","yàhn","tēng","yèh","sōu","góng","wah","dīk","sìh","hauh",null,"yèh","sōu","yān","waih","yíh","làhm","gahn","yèh","louh","saat","láahng",null,"yìh","ché","tā","mùhn","dōu","yíh","wàih","tīn","jyú","dīk","gwok","faai","yiu","chēut","yihn",null,"seuih","chit","líuh","yāt","go","béi","yuh","syut",null,null,"yáuh","yāt","go","gwai","yàhn","héi","sān","dou","yúhn","fōng","heui",null,"waih","chéui","dāk","líuh","wòhng","waih","joi","wùih","lòih",null,"tā","jēung","jih","géi","dīk","sahp","go","buhk","yàhn","giu","lòih",null,"gāau","kāp","tā","mùhn","sahp","go",null,"máih","naahp",null,null,"ngàhn","baih",null,null,"bihng","jūk","fuh","syut",null,"néih","mùhn","nàh","heui","jouh","sāang","yi",null,"jihk","dou","ngóh","wùih","lòih",null,"tā","bún","gwok","dīk","yàhn","yāt","heung","wàaih","hahn","tā",null,"seuih","joih","tā","hauh","mihn","paai","doih","bíu","heui","syut",null,"ngóh","mùhn","bāt","yuhn","yi","jéh","yàhn","wàih","wòhng","túng","jih","ngóh","mùhn",null,"jéh","gwai","yàhn","dāk","líuh","wòhng","waih","gwāi","lòih","yíh","hauh",null,"bihn","chyùhn","jiuh","náh","sē","líhng","líuh","tā","chín","dīk","buhk","yàhn",null,"séung","jī","dou","múih","go","yàhn","jouh","sāang","yi","jaahn","líuh","dō","síu",null,"daih","yāt","go","chìhn","lòih","syut",null,"jyú",null,"néih","dīk","náh","go",null,"máih","naahp",null,null,"ngàhn","baih",null,"jaahn","líuh","sahp","go",null,"máih","naahp",null,null,"ngàhn","baih",null,null,"jyú","yàhn","deui","tā","syut",nul