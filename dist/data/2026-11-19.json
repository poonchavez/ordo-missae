euhk","yāt","waih","dōng","dāk","héi","jín","hōi","náh","syū","gyún","wòh","yuht","duhk","tā","dīk",null,"jéung","lóuh","jūng","yáuh","yāt","waih","deui","ngóh","syut",null,null,"bāt","yiu","hūk",null,"hon",null,"náh","chēut","yū","yàuh","daaih","jī","paai","jūng","dīk","sī","jí",null,"daaht","meih","dīk","mìuh","yeuih","yíh","dāk","líuh","sing","leih",null,"tā","nàhng","jín","hōi","náh","syū","gyún","wòh","hōi","kái","náh","chāt","go","yan",null,null]},{"zh":"我就看見在寶座和四個活物中間，並在長老中間，站著一隻羔羊，好像被宰殺過的，他有七個角和七隻眼：那眼睛就是被派往全地的天主的七神。他於是前來，從坐在寶座上的那位右手中接了那書卷。當他接過那書卷的時候，那四個活物和那二十四位長老，都俯伏在羔羊前，各拿著弦琴和盛滿了香料的金盂——這香料即是眾聖徒的祈禱，並唱新歌說：「惟有你當得起接受那書卷和開啟它的印，因為你曾被宰殺，曾用你的血，從各支派、各語言、各民族、各邦國中，把人贖回來歸於天主，並使他們成為國度和司祭，事奉我們的天主；他們必要為王，統治世界。」","yale":["ngóh","jauh","hon","gin","joih","bóu","joh","wòh","sei","go","wuht","maht","jūng","gāan",null,"bihng","joih","jéung","lóuh","jūng","gāan",null,"jaahm","jeuhk","yāt","jek","gōu","yèuhng",null,"hóu","jeuhng","beih","jói","saat","gwo","dīk",null,"tā","yáuh","chāt","go","gok","wòh","chāt","jek","ngáahn",null,"náh","ngáahn","jīng","jauh","sih","beih","paai","wóhng","chyùhn","deih","dīk","tīn","jyú","dīk","chāt","sàhn",null,"tā","yū","sih","chìhn","lòih",null,"chùhng","joh","joih","bóu","joh","seuhng","dīk","náh","waih","yauh","sáu","jūng","jip","líuh","náh","syū","gyún",null,"dōng","tā","jip","gwo","náh","syū","gyún","dīk","sìh","hauh",null,"náh","sei","go","wuht","maht","wòh","náh","yih","sahp","sei","waih","jéung","lóuh",null,"dōu","fú","fuhk","joih","gōu","yèuhng","chìhn",null,"gok","nàh","jeuhk","yìhn","kàhm","wòh","sihng","múhn","líuh","hēung","líu","dīk","gām","yùh",null,null,"jéh","hēung","líu","jīk","sih","jung","sing","tòuh","dīk","kèih","tóu",null,"bihng","cheung","sān","gō","syut",null,null,"wàih","yáuh","néih","dōng","dāk","héi","jip","sauh","náh","syū","gyún","wòh","hōi","kái","tā","dīk","yan",null,"yān","waih","néih","chàhng","beih","jói","saat",null,"chàhng","yuhng","néih","dīk","hyut",null,"chùhng","gok","jī","paai",null,"gok","yúh","yìhn",null