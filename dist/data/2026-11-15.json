"chòhng","joih","deih","há",null,"hon",null,"néih","dīk",null,"yìhng","wàahn","kāp","néih",null]},{"zh":"「主人回答說：可惡懶惰的僕人！你既知道：我在沒有下種的地方收割，在沒有散布的地方聚斂；那麼，你該把我的銀子，交給錢莊裡的人，待我回來時，連本帶利，收回給我。所以，你們從他手中，把這個『塔冷通』奪過來，給那有了十個『塔冷通』的。因為凡是有的，還要給他，叫他富裕；那沒有的，連他所有的，也要由他手中奪去。至於這個無用的僕人，你們把他丟在外面的黑暗中；在那裡必有哀號和切齒。」","yale":[null,"jyú","yàhn","wùih","daap","syut",null,"hó","wu","láahn","doh","dīk","buhk","yàhn",null,"néih","gei","jī","dou",null,"ngóh","joih","muht","yáuh","hah","júng","dīk","deih","fōng","sāu","got",null,"joih","muht","yáuh","saan","bou","dīk","deih","fōng","jeuih","líhm",null,"náh","mō",null,"néih","gōi","bá","ngóh","dīk","ngàhn","jí",null,"gāau","kāp","chìhn","jōng","léuih","dīk","yàhn",null,"doih","ngóh","wùih","lòih","sìh",null,"lìhn","bún","daai","leih",null,"sāu","wùih","kāp","ngóh",null,"só","yíh",null,"néih","mùhn","chùhng","tā","sáu","jūng",null,"bá","jéh","go",null,"taap","láahng","tūng",null,"dyuht","gwo","lòih",null,"kāp","náh","yáuh","líuh","sahp","go",null,"taap","láahng","tūng",null,"dīk",null,"yān","waih","fàahn","sih","yáuh","dīk",null,"wàahn","yiu","kāp","tā",null,"giu","tā","fu","yuh",null,"náh","muht","yáuh","dīk",null,"lìhn","tā","só","yáuh","dīk",null,"yáh","yiu","yàuh","tā","sáu","jūng","dyuht","heui",null,"ji","yū","jéh","go","mòuh","yuhng","dīk","buhk","yàhn",null,"néih","mùhn","bá","tā","dīu","joih","ngoih","mihn","dīk","hāak","am","jūng",null,"joih","náh","léuih","bīt","yáuh","ōi","houh","wòh","chit","chí",null,null]},{"zh":"——上主的話。","yale":[null,null,"seuhng","jyú","dīk","wah",null]},{"zh":"眾：基督，我們讚美你。","yale":["jung",null,"gēi","dūk",null,"ngóh","mùhn","jaan","méih","néih",null]},{"zh":"（講道後默想片刻）","yale":[null,"góng","douh","hauh","mahk","séung","pin","hāk",null]},{"zh":"【短式】","yale":[null,"dyún","sīk",null]}],"enMissing":["25:14","25:15","25:16","25:17","25:18","25:19","25:20","25:21","25:22","25:23","25:24","25:25","25:26","25:27","25:28","25:29","25:30"]}]}