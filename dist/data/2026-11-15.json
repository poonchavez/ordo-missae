ines":[{"zh":"主祭：願主與你們同在。","yale":["jyú","jai",null,"yuhn","jyú","yúh","néih","mùhn","tùhng","joih",null]},{"zh":"眾：也與你的心靈同在。","yale":["jung",null,"yáh","yúh","néih","dīk","sām","lìhng","tùhng","joih",null]},{"zh":"恭讀聖瑪竇福音","yale":["gūng","duhk","sing","máh","dauh","fūk","yām"]},{"zh":"眾：主，願光榮歸於你。","yale":["jung",null,"jyú",null,"yuhn","gwōng","wìhng","gwāi","yū","néih",null]},{"zh":"那時候，耶穌給門徒講了這個比喻，說：「天國好像一個要遠行的人，將自己的僕人叫來，把財產託付給他們：按照他們的才能，一個給了五個『塔冷通』，一個給了兩個，一個給了一個；然後動身走了。","yale":["náh","sìh","hauh",null,"yèh","sōu","kāp","mùhn","tòuh","góng","líuh","jéh","go","béi","yuh",null,"syut",null,null,"tīn","gwok","hóu","jeuhng","yāt","go","yiu","yúhn","hàahng","dīk","yàhn",null,"jēung","jih","géi","dīk","buhk","yàhn","giu","lòih",null,"bá","chòih","cháan","tok","fuh","kāp","tā","mùhn",null,"on","jiu","tā","mùhn","dīk","chòih","nàhng",null,"yāt","go","kāp","líuh","ńgh","go",null,"taap","láahng","tūng",null,null,"yāt","go","kāp","líuh","léuhng","go",null,"yāt","go","kāp","líuh","yāt","go",null,"yìhn","hauh","duhng","sān","jáu","líuh",null]},{"zh":"「那領了五個『塔冷通』的，立刻去用來營業，另外賺了五個。同樣，那領了兩個的，也賺了另外兩個。但是，那領了一個的，卻去把地掘開，把主人的銀子，埋藏起來。","yale":[null,"náh","líhng","líuh","ńgh","go",null,"taap","láahng","tūng",null,"dīk",null,"laahp","hāk","heui","yuhng","lòih","yìhng","yihp",null,"lihng","ngoih","jaahn","líuh","ńgh","go",null,"tùhng","yeuhng",null,"náh","líhng","líuh","léuhng","go","dīk",null,"yáh","jaahn","líuh","lihng","ngoih","léuhng","go",null,"daahn","sih",null,"náh","líhng","líuh","yāt","go","dīk",null,"keuk","heui","bá","deih","gwaht","hōi",null,"bá","jyú","yàhn","dīk","ngàhn","jí",null,"màaih","chòhng","héi","lòih",null]},{"zh":"「過了很久，僕人的主人回來了，便與僕人算賬。那領了五個『塔冷通』的，上前，呈上另外五個『塔冷通』，說：主啊！你曾交給我五個『塔冷通』，看，我賺了另外五個『塔冷通』。主人對他說：好！善良忠信的僕人，你既在少許事上忠信，我必委派你管理許多大事：進入你主人的福樂吧！","yale":[null,"gwo","líuh","hán","gáu",null,"buhk","yàhn","dīk","jyú","yàhn","wùih","lòih","líuh",null,"bihn","yúh","buhk","yàhn","syun","jeung",null,"náh","líhng","líuh","ńgh","go",null,"taap","láahng","tūng",null,"dīk",null,"